# ==============================================
# OmniBrain Environment Configuration Template
# ==============================================

# -------------------------------------------------------------
# 1. Vision-Language Model (VLM) Configuration (Pods 2A & 2B)
# -------------------------------------------------------------
# Provider options: 'gemini' (Recommended / Free Tier), 'openai', 'ollama' (Local), or 'mock' (Offline)
VLM_PROVIDER=gemini

# Google Gemini API Key (Get a free API key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-flash-latest

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Local Open-Source Ollama (Optional, 100% offline & free)
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=llava:13b

# -------------------------------------------------------------
# 2. Vector Database (Qdrant)
# -------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=omnibrain_docs
QDRANT_API_KEY=

# -------------------------------------------------------------
# 3. Relational Database (SQL Agent)
# -------------------------------------------------------------
DATABASE_URL=sqlite:///./storage/financial_data.db

# -------------------------------------------------------------
# 4. Observability & Tracing (Langfuse - Optional)
# -------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# -------------------------------------------------------------
# 5. Server & API Settings
# -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501
ENVIRONMENT=development
LOG_LEVEL=INFO
